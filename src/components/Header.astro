---
import { SITE_TITLE } from '../consts';
import { hasPosts } from '../lib';

const path = Astro.url.pathname;
// The Blog link only appears once a post is published.
const links = (await hasPosts()) ? [{ href: '/blog/', label: 'Blog' }] : [];
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-8 sm:px-8">
  <a href="/" class="text-[0.95rem] tracking-tight">{SITE_TITLE}</a>
  {
    links.length > 0 && (
      <nav aria-label="Main">
        <ul class="flex gap-8 text-[0.95rem]">
          {links.map(({ href, label }) => {
            const active = path.startsWith(href);
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={['transition-colors hover:text-ink', active ? 'text-ink' : 'text-slate']}
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</header>
